{
  "manifest_version": 3,
  "name": "AI-Chat SmartSend",
  "version": "1.0.0",
  "description": "Send messages in AI chat apps with Ctrl+Enter or Cmd+Enter. Shift+Enter preserves text.",
  
  "icons": {
    "16": "icons/icon-16x16.png",
    "32": "icons/icon-32x32.png",
    "48": "icons/icon-48x48.png",
    "128": "icons/icon-128x128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
