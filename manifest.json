{
  "manifest_version": 3,
  "name": "AIChat SmartSend",
  "version": "1.0.0",
  "description": "Send messages in AI chat apps with Ctrl+Enter or Cmd+Enter. Shift+Enter preserves text.",
  
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
